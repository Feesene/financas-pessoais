DATABASE_TYPE=sqlite
DATABASE_PATH=./data/financas.db
DB_SYNCHRONIZE=true
PORT=3001
NODE_ENV=development

# (Produção) Segredo do Vercel Cron que mantém o Supabase ativo (keep-alive).
# O Vercel injeta "Authorization: Bearer <CRON_SECRET>" nas invocações do cron; o endpoint
# /health/keepalive exige esse valor quando a env está definida. Vazio em dev. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
