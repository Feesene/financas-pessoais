# Database (Postgres / docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financas-pessoais
POSTGRES_PORT=5432

# Backend (NestJS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financas-pessoais
PORT=3001
NODE_ENV=development

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
