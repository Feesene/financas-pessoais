# Database (Postgres / docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financas-pessoais
POSTGRES_PORT=5432

# Backend (NestJS)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/financas.db
DB_SYNCHRONIZE=true
PORT=3001
NODE_ENV=development

# Frontend (Next.js)
# URL do backend usada pelas server actions (lado servidor, não exposta ao navegador).
# Mantém NEXT_PUBLIC_API_URL como fallback para compatibilidade.
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
