# Database (Postgres / docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financas-pessoais
POSTGRES_PORT=5432

# Backend (NestJS)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/financas.db
DB_SYNCHRONIZE=true
PORT=3001
NODE_ENV=development

# --- Produção na nuvem (Supabase + Vercel) ---
# No deploy do backend, defina DATABASE_TYPE=postgres e as variáveis abaixo na Vercel
# (nunca versione valores reais). Em desenvolvimento, mantenha o bloco acima.
#
# Runtime serverless usa a connection string COM POOLER do Supabase (PgBouncer, porta 6543).
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Conexão DIRETA (porta 5432) — usada SOMENTE para rodar migrations (não no runtime).
# DIRECT_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# Habilita TLS exigido pelo Supabase (use "true" em produção/migrations na nuvem).
# DATABASE_SSL=true
# Máximo de conexões por instância serverless (mantenha enxuto). Padrão: 1.
# DATABASE_POOL_MAX=1
# Origens permitidas pelo CORS (lista por vírgula) = URL(s) do frontend na Vercel.
# Em produção, sem esta variável o CORS bloqueia tudo (falha fechada).
# CORS_ORIGINS=https://<frontend>.vercel.app

# Frontend (Next.js)
# URL do backend usada pelas server actions (lado servidor, não exposta ao navegador).
# Mantém NEXT_PUBLIC_API_URL como fallback para compatibilidade.
# Em produção, aponte para a URL pública da API na Vercel: https://<backend>.vercel.app
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Autenticação do frontend (portão de senha única)
# Senha de acesso ao app. Obrigatória — sem ela o login é recusado (fail-safe).
APP_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão (JWT HS256). Use >= 32 bytes aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes-no-minimo
# Tempo de vida da sessão em segundos. Opcional (padrão: 604800 = 7 dias).
AUTH_SESSION_TTL=604800
