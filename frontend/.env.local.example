# URL do backend usada pelas server actions (lado servidor, não exposta ao navegador).
# Em produção (Vercel), aponte para a URL pública da API: https://<backend>.vercel.app
API_URL=http://localhost:3001

# (Produção) Chave de API compartilhada com o backend (MESMO valor da env API_KEY no projeto
# backend). O frontend a envia no header x-api-key; sem ela o backend responde 401. Vazio em dev.
# API_KEY=

# Autenticação (portão de senha única)
# Senha de acesso ao app. Obrigatória — sem ela o login é recusado (fail-safe).
APP_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão (JWT HS256). Use >= 32 bytes aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes-no-minimo
# Tempo de vida da sessão em segundos. Opcional (padrão: 604800 = 7 dias).
AUTH_SESSION_TTL=604800
